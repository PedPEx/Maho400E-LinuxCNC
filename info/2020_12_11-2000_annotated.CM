; ------------------------------------------------------------
; HARDWARE-KONFIGURATION
; ------------------------------------------------------------
N0 C1      ; MC0  | Anzahl I/O-Karten: 1 = eine I/O-Karte
N1 C4      ; MC1  | Anzahl Drive-Module: 4
N2 C224    ; MC2  | Gesamtspeicher NC-RAM: 224 KByte
N4 C0      ; MC4  | Handbedienpult: 0 = kein Handbedienpult
N9 C1      ; MC9  | Grafikmodul: 1 = 2-Ebenen-Modul

; ------------------------------------------------------------
; MASCHINEN-KONFIGURATION
; ------------------------------------------------------------
N10 C3     ; MC10 | Anzahl der Achsen: 3
N11 C0     ; MC11 | Ebenenanwahl bei Netz-Ein: 0 = G17 (XY-Ebene)
N14 C71    ; MC14 | Messsystemtyp: 71 = metrisch (70 = Zoll)
N27 C99    ; MC27 | Anzahl der Werkzeuge im Magazin: 99
N39 C0     ; MC39 | Verzoegerung Ausgaenge Werkzeugmagazin: 0 x 15ms = 0ms

; ------------------------------------------------------------
; M/T-ADRESS-AUSGABE
; ------------------------------------------------------------
N61 C5     ; MC61 | Ausgabe M-Adresse: 5 = dekodiert und BCD
N63 C0     ; MC63 | Ausgabe T-Adresse: 0 = Aus (keine T-Adr.-Ausgabe)

; ------------------------------------------------------------
; SOFTWARE-KONFIGURATION CNC
; ------------------------------------------------------------
N80 C0     ; MC80 | Demo-Modus: 0 = Aus
N81 C0     ; MC81 | Anzeigart Bildschirm: 0 = dist-to-go (Restweg)
N82 C99    ; MC82 | Anzahl der Punktedefinitionen: 99
N83 C99    ; MC83 | Anzahl der E-Parameter: 99
N84 C0     ; MC84 | Anzeige Programmnummern: 0 = mit Text
N85 C50    ; MC85 | Anzahl der Programme und Macros: 50
N86 C1     ; MC86 | Softkey lock/unlock: 1 = aktiv

; ------------------------------------------------------------
; ACHSEN-KONFIGURATION – Anwahl und Zuordnung
; Adressbezeichnung: X=88, Y=89, Z=90, A=65, B=66
; Zuordnung MC-Block: 1=MC200-249, 2=MC250-299, 3=MC300-349,
;                     4=MC350-399, 5=MC400-449, 6=MC450-499
; ------------------------------------------------------------

; --- 1. Achse: X ---
N100 C1    ; MC100 | 1. Achse Funktion: 1 = geschlossener Lageregelkreis
N101 C1    ; MC101 | 1. Achse MC-Block-Zuordnung: 1 = MC200–MC249
N103 C88   ; MC103 | 1. Achse Adressbezeichnung: 88 = X

; --- 2. Achse: Y ---
N105 C1    ; MC105 | 2. Achse Funktion: 1 = geschlossener Lageregelkreis
N106 C3    ; MC106 | 2. Achse MC-Block-Zuordnung: 3 = MC300–MC349
N108 C89   ; MC108 | 2. Achse Adressbezeichnung: 89 = Y

; --- 3. Achse: Z ---
N110 C1    ; MC110 | 3. Achse Funktion: 1 = geschlossener Lageregelkreis
N111 C2    ; MC111 | 3. Achse MC-Block-Zuordnung: 2 = MC250–MC299
N113 C90   ; MC113 | 3. Achse Adressbezeichnung: 90 = Z

; --- 4. Achse: B (Rundachse, inaktiv) ---
N116 C4    ; MC116 | 4. Achse MC-Block-Zuordnung: 4 = MC350–MC399
N118 C66   ; MC118 | 4. Achse Adressbezeichnung: 66 = B

; ============================================================
; ACHS-PARAMETER-BLOCK 1. ACHSE: X  (MC200–MC249)
