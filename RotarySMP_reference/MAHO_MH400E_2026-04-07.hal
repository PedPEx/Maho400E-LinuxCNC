# --- MACHINE STATE --- 
#Output MACHINE-IS-ON to latch the 19K1 relay.
net machine-is-on  hm2_5i25.0.7i84.0.2.output-08

# --- Z BRAKE ---
#Release Z brake when machine-is-on
net machine-is-on => hm2_5i25.0.7i77.0.0.output-00

#---- TOOL CHANGE ---- 
net tool_release => hm2_5i25.0.7i84.0.2.output-09

