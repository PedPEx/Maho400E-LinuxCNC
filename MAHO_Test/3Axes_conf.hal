#########################################
# Axis X / Joint 0
# Drive board 1 / slot 1 → EL4034 aout-0 / EP5101-x
# OUTPUT_SCALE=+10, ENCODER_SCALE=-1000 (direction inverted)
# Homing: EP5101 Latch-C (no index-enable, no physical switch)
# enableCReset=0 must be set in ethercat-conf_3axes.xml!
#########################################

setp pid.x.Pgain                    [JOINT_0]P
setp pid.x.Igain                    [JOINT_0]I
setp pid.x.Dgain                    [JOINT_0]D
setp pid.x.bias                     [JOINT_0]BIAS
setp pid.x.FF0                      [JOINT_0]FF0
setp pid.x.FF1                      [JOINT_0]FF1
setp pid.x.FF2                      [JOINT_0]FF2
setp pid.x.deadband                 [JOINT_0]DEADBAND
setp pid.x.maxoutput                [JOINT_0]MAX_OUTPUT
setp pid.x.error-previous-target    true

setp lcec.m0.EP5101-x.enc-pos-scale [JOINT_0]ENCODER_SCALE
setp lcec.m0.EL4034.aout-0-scale    [JOINT_0]OUTPUT_SCALE

net x-enable     joint.0.amp-enable-out    =>  pid.x.enable lcec.m0.EL4034.aout-0-enable
net x-pos-cmd    joint.0.motor-pos-cmd     =>  pid.x.command
#net x-vel-cmd    ddt.x.out                 =>  pid.x.command-deriv
net x-pos-fb     lcec.m0.EP5101-x.enc-pos  =>  pid.x.feedback joint.0.motor-pos-fb
net x-output     pid.x.output              =>  lcec.m0.EL4034.aout-0-value

# Homing – Re-arm oneshot (short): resets ena-latch-c to re-arm EP5101
setp oneshot.xrearm.width          0.020   # 20ms – long enough for EP5101 to reset latch
setp oneshot.xrearm.retriggerable  0

# Homing – Home-sw hold oneshot (long): keeps home-sw-in TRUE during backoff
setp oneshot.xsw.width             0.300   # 300ms – tune to match backoff distance
setp oneshot.xsw.retriggerable     0

# Both oneshots triggered by latch-c-valid
net x-latch-valid  lcec.m0.EP5101-x.enc-latch-c-valid  =>  oneshot.xrearm.in  oneshot.xsw.in

# ena-latch-c = joint.homing AND NOT(rearm_oneshot)
net x-rearm-inv  oneshot.xrearm.out  =>  not.xhome.in
net x-rearm-n    not.xhome.out       =>  and2.xhome.in0
net x-homing     joint.0.homing      =>  and2.xhome.in1
net x-ena-latch  and2.xhome.out      =>  lcec.m0.EP5101-x.enc-ena-latch-c

# home-sw-in driven by long oneshot
net x-home-sw    oneshot.xsw.out     =>  joint.0.home-sw-in


#########################################
# Axis Y / Joint 1
# Drive board 2 / slot 1 → EL4034 aout-1 / EP5101-y
# OUTPUT_SCALE=-10 (inverted!), ENCODER_SCALE=-200 (different resolver + inverted!)
# Homing: EP5101 Latch-C (no index-enable, no physical switch)
# enableCReset=0 must be set in ethercat-conf_3axes.xml!
#########################################

setp pid.y.Pgain                    [JOINT_0]P
setp pid.y.Igain                    [JOINT_0]I
setp pid.y.Dgain                    [JOINT_0]D
setp pid.y.bias                     [JOINT_0]BIAS
setp pid.y.FF0                      [JOINT_0]FF0
setp pid.y.FF1                      [JOINT_0]FF1
setp pid.y.FF2                      [JOINT_0]FF2
setp pid.y.deadband                 [JOINT_0]DEADBAND
setp pid.y.maxoutput                [JOINT_0]MAX_OUTPUT
setp pid.y.error-previous-target    true

setp lcec.m0.EP5101-y.enc-pos-scale [JOINT_0]ENCODER_SCALE
setp lcec.m0.EL4034.aout-2-scale    [JOINT_0]OUTPUT_SCALE

net y-enable     joint.1.amp-enable-out    =>  pid.y.enable lcec.m0.EL4034.aout-2-enable
net y-pos-cmd    joint.1.motor-pos-cmd     =>  pid.y.command
#net y-vel-cmd    ddt.y.out                 =>  pid.y.command-deriv
net y-pos-fb     lcec.m0.EP5101-y.enc-pos  =>  pid.y.feedback joint.1.motor-pos-fb
net y-output     pid.y.output              =>  lcec.m0.EL4034.aout-2-value

# Homing – Re-arm oneshot (short): resets ena-latch-c to re-arm EP5101
setp oneshot.yrearm.width          0.020   # 20ms – long enough for EP5101 to reset latch
setp oneshot.yrearm.retriggerable  0

# Homing – Home-sw hold oneshot (long): keeps home-sw-in TRUE during backoff
setp oneshot.ysw.width             0.300   # 300ms – tune to match backoff distance
setp oneshot.ysw.retriggerable     0

# Both oneshots triggered by latch-c-valid
net y-latch-valid  lcec.m0.EP5101-y.enc-latch-c-valid  =>  oneshot.yrearm.in  oneshot.ysw.in

# ena-latch-c = joint.homing AND NOT(rearm_oneshot)
net y-rearm-inv  oneshot.yrearm.out  =>  not.yhome.in
net y-rearm-n    not.yhome.out       =>  and2.yhome.in0
net y-homing     joint.1.homing      =>  and2.yhome.in1
net y-ena-latch  and2.yhome.out      =>  lcec.m0.EP5101-y.enc-ena-latch-c

# home-sw-in driven by long oneshot
net y-home-sw    oneshot.ysw.out     =>  joint.1.home-sw-in



#########################################
# Axis Z / Joint 2
# Drive board 1 / slot 2 → EL4034 aout-2 / EP5101-z
# OUTPUT_SCALE=-10 (inverted!), ENCODER_SCALE=+1000
# HOME_SEQUENCE=0 → Z is always homed FIRST, before X and Y!
# Homing: EP5101 Latch-C (no index-enable, no physical switch)
# enableCReset=0 must be set in ethercat-conf_3axes.xml!
#########################################

setp pid.z.Pgain                    [JOINT_0]P
setp pid.z.Igain                    [JOINT_0]I
setp pid.z.Dgain                    [JOINT_0]D
setp pid.z.bias                     [JOINT_0]BIAS
setp pid.z.FF0                      [JOINT_0]FF0
setp pid.z.FF1                      [JOINT_0]FF1
setp pid.z.FF2                      [JOINT_0]FF2
setp pid.z.deadband                 [JOINT_0]DEADBAND
setp pid.z.maxoutput                [JOINT_0]MAX_OUTPUT
setp pid.z.error-previous-target    true

setp lcec.m0.EP5101-z.enc-pos-scale [JOINT_0]ENCODER_SCALE
setp lcec.m0.EL4034.aout-1-scale    [JOINT_0]OUTPUT_SCALE

net z-enable     joint.2.amp-enable-out    =>  pid.z.enable lcec.m0.EL4034.aout-1-enable
net z-pos-cmd    joint.2.motor-pos-cmd     =>  pid.z.command
#net z-vel-cmd    ddt.z.out                 =>  pid.z.command-deriv
net z-pos-fb     lcec.m0.EP5101-z.enc-pos  =>  pid.z.feedback joint.2.motor-pos-fb
net z-output     pid.z.output              =>  lcec.m0.EL4034.aout-1-value

# Homing – Re-arm oneshot (short): resets ena-latch-c to re-arm EP5101
setp oneshot.zrearm.width          0.020   # 20ms – long enough for EP5101 to reset latch
setp oneshot.zrearm.retriggerable  0

# Homing – Home-sw hold oneshot (long): keeps home-sw-in TRUE during backoff
setp oneshot.zsw.width             0.300   # 300ms – tune to match backoff distance
setp oneshot.zsw.retriggerable     0

# Both oneshots triggered by latch-c-valid
net z-latch-valid  lcec.m0.EP5101-z.enc-latch-c-valid  =>  oneshot.zrearm.in  oneshot.zsw.in

# ena-latch-c = joint.homing AND NOT(rearm_oneshot)
net z-rearm-inv  oneshot.zrearm.out  =>  not.zhome.in
net z-rearm-n    not.zhome.out       =>  and2.zhome.in0
net z-homing     joint.2.homing      =>  and2.zhome.in1
net z-ena-latch  and2.zhome.out      =>  lcec.m0.EP5101-z.enc-ena-latch-c

# home-sw-in driven by long oneshot
net z-home-sw    oneshot.zsw.out     =>  joint.2.home-sw-in
