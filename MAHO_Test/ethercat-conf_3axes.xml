			<modParam name="ch2_invert_polarity"      value="false"/>      <!--      (8032:09)                  -->
			<modParam name="ch2_torque_error_enable"  value="false"/>      <!--      (8032:0A)                  -->
			<modParam name="ch2_torque_auto_reduce"   value="false"/>      <!--      (8032:0B)                  -->
