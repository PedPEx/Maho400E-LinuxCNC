			<modParam name="ch2_function_din1"        value="0"/>          <!-- 0=normal input (8032:32)        -->
			<modParam name="ch2_function_din2"        value="0"/>          <!-- 0=normal input (8032:36)        -->
			<modParam name="ch2_enable_info_sdo"      value="false"/>      <!-- cyclic 9030 info reads          -->
			<!-- ================= Device-wide ================= -->
			<modParam name="pwm_frequency"            value="30000"/>      <!-- Hz   (F80F:01)                  -->
			<modParam name="warning_temp"             value="80"/>         <!-- °C   (F80F:04)                  -->
