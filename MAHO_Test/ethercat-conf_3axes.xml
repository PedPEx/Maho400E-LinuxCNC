			<dcConf assignActivate="700" sync0Cycle="*1" sync0Shift="0" sync1Cycle="100000" sync1Shift="0"/>
		</slave>
		<slave idx="14" type="generic" vid="0x00000002" pid="0x23963052" name="EL9110-Mot">
			<syncManager idx="0" dir="in">
				<pdo idx="1a00">
					<pdoEntry idx="6000" subIdx="01" bitLen="1" halPin="PowerOk" halType="bit"/>
