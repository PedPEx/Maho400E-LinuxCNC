<masters>
	<!-- Internal EtherCAT Master 0 - Internal Key Busslaves only! -->
		<!--DC note: ESI <OpMode> maps to lcec as follows —
			AssignActivate        -> assignActivate
			CycleTimeSync0 Factor -> sync0Cycle ("*1" = 1 x appTimePeriod)
			ShiftTimeSync0        -> sync0Shift
			ShiftTimeSync1        -> sync1Cycle  (!), sync1Shift stays 0
			IgH writes sync1Cycle verbatim to register 0x09A4, which the ESC reads as the
			SYNC1 delay after SYNC0. Passing the offset as sync1Shift has no effect, and
			sync1Cycle="*1" makes SYNC1 coincide with the next SYNC0 -> AL 0x002C. 			-->
	<master idx="0" appTimePeriod="1000000" refClockSyncCycles="1" refClockSlaveIdx="2" name="m0">
		<slave idx="0" type="EK1914" name="EK1914"/>
		<slave idx="1" type="EL1918" name="EL1918">
			<modParam name="fsoeSlaveIdx" value="0"/>
			<!-- Standard-Inputs: 0xf788 -->
			<modParam name="stdInName" value="err-ack"/>
			<modParam name="stdInName" value="run"/>
			<modParam name="stdInName" value="safe-out1"/>
			<modParam name="stdInName" value="safe-out2"/>
			<!-- Standard-Outputs: 0xf688 -->
			<modParam name="stdOutName" value="safety-ok"/>
			<modParam name="stdOutName" value="safe-error"/>
		</slave>
		<slave idx="2" type="EL5002" name="EL5002">
			<!-- EL5002 (slave 2): DC per Beckhoff ESI (OpMode "DC") — SYNC0 on cycle start, SYNC1 +15us -->
			<dcConf assignActivate="700" sync0Cycle="*1" sync0Shift="0" sync1Cycle="15000" sync1Shift="0"/>
			<!-- ===== Channel 0 (base 0x8000) — SICK ATM60 spindle encoder ===== -->
			<modParam name="ch0DisFrameErr"     value="false"/> <!-- 8000:01 BOOL  false=frame errors evaluated       -->
			<modParam name="ch0EnPwrFailChk"    value="false"/> <!-- 8000:02 BOOL  encoder power-fail bit check        -->
			<modParam name="ch0EnInhibitTime"   value="false"/> <!-- 8000:03 BOOL  enable min. inhibit time            -->
			<modParam name="ch0ClkJitComp"      value="false"/> <!-- 8000:0C BIT3  clock jitter compensation (FW03+)   -->
			<modParam name="ch0Coding"          value="1"/>     <!-- 8000:06 BIT1  0=binary, 1=gray (ATM60=gray)       -->
			<modParam name="ch0Baudrate"        value="2"/>     <!-- 8000:09 BIT3  1=1250 2=1000 3=500 4=250 5=125 kBd  -->
			<modParam name="ch0FrameType"       value="2"/>     <!-- 8000:0F BIT2  0=MT25 1=ST13 2=variable(->size)     -->
			<modParam name="ch0FrameSize"       value="24"/>    <!-- 8000:11 U16   total SSI clocks (needs type=2)      -->
			<modParam name="ch0DataLen"         value="24"/>    <!-- 8000:12 U16   significant data bits (12 ST +12 MT) -->
			<modParam name="ch0MinInhibitTime"  value="0"/>     <!-- 8000:13 U16   min. inhibit time [µs]               -->
			<modParam name="ch0NoClkBursts"     value="1"/>     <!-- 8000:14 U16   clock bursts, min 1 (FW03+)          -->
			<!-- ===== Channel 1 (base 0x8010) — unused, no encoder connected ===== -->
			<modParam name="ch1DisFrameErr"     value="false"/> <!-- 8010:01 BOOL                                      -->
			<modParam name="ch1EnPwrFailChk"    value="false"/> <!-- 8010:02 BOOL                                      -->
			<modParam name="ch1EnInhibitTime"   value="false"/> <!-- 8010:03 BOOL                                      -->
			<modParam name="ch1ClkJitComp"      value="false"/> <!-- 8010:0C BIT3  (FW03+)                             -->
			<modParam name="ch1Coding"          value="1"/>     <!-- 8010:06 BIT1  0=binary, 1=gray                    -->
			<modParam name="ch1Baudrate"        value="2"/>     <!-- 8010:09 BIT3  1=1250 2=1000 3=500 4=250 5=125 kBd  -->
			<modParam name="ch1FrameType"       value="2"/>     <!-- 8010:0F BIT2  0=MT25 1=ST13 2=variable(->size)     -->
			<modParam name="ch1FrameSize"       value="24"/>    <!-- 8010:11 U16   total SSI clocks (needs type=2)      -->
			<modParam name="ch1DataLen"         value="24"/>    <!-- 8010:12 U16   significant data bits                -->
			<modParam name="ch1MinInhibitTime"  value="0"/>     <!-- 8010:13 U16   min. inhibit time [µs]               -->
			<modParam name="ch1NoClkBursts"     value="1"/>     <!-- 8010:14 U16   clock bursts, min 1 (FW03+)          -->
		</slave>
		<slave idx="3" type="EL5021" name="EL5021-x">
			<!-- EL5021: DC per Beckhoff ESI (OpMode "DC") — SYNC0 -65us pre-trigger, SYNC1 +25us -->
			<dcConf assignActivate="700" sync0Cycle="*1" sync0Shift="-65000" sync1Cycle="25000" sync1Shift="0"/>
		    <!-- 8000:01  Enable counter reset via C input (BIT).
    		Keep false for the latch-C homing scheme.                        -->
      		<modParam name="enableCReset"          value="false"/>
			<!-- 8000:0E  Reverse counting direction (BIT).
			Prefer inverting via enc.pos-scale sign in HAL instead.          -->
			<modParam name="reversionOfRotation"   value="false"/>
			<!-- 8001:01  Enable frequency error detection (BIT). factory ON       -->
			<modParam name="enableFrequencyError"  value="true"/>
			<!-- 8001:02  Enable amplitude error detection (BIT). factory ON       -->
			<modParam name="enableAmplitudeError"  value="true"/>
			<!-- 8001:11  Period resolution in bits (U32). 10 -> fmax = 250 kHz    -->
			<modParam name="analogResolution"      value="10"/>
		</slave>
		<slave idx="4" type="EL5021" name="EL5021-y">
			<!-- EL5021: DC per Beckhoff ESI (OpMode "DC") — SYNC0 -65us pre-trigger, SYNC1 +25us -->
