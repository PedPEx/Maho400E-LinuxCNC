component mh400e_toolchange "MAHO MH400E tool clamp control: blinking button lamp, two-press valve sequence and iocontrol tool-change handshake";

description """
Tool clamping control for the MAHO MH400E retrofit.

The machine has no automatic tool changer: the tool is released by a hydraulic
valve and has to be swapped by hand. This component drives the valve, the lamp
inside the release button and the LinuxCNC iocontrol handshake, so that a tool
change requested by a T/M6 command and a tool change started manually at the
button behave identically from the operator's point of view.

Lamp coding (all patterns are generated inside this component):
  steady on      Spindle is stopped and the machine is idle - a manual tool
                 change may be started by pressing the button.
  slow blink     A tool change was requested by the interpreter (M6). The valve
                 is still closed, the operator has to confirm with the button.
  double flash   The valve is open, the tool is free and can be swapped. A
                 second press clamps the tool back into the taper.
  off            Component disabled, or clamping movement in progress.

Sequence started by M6 (tool-change):
  IDLE -> WAIT_OPEN (slow blink) -> button -> OPEN (valve on, double flash)
       -> button -> CLOSE (valve off, clamp-time) -> FINISH (tool-changed)

Sequence started at the button (spindle stopped, lamp steady on):
  The press that starts the change already counts as the first press, so the
  valve opens immediately. Because the tool then leaves the spindle outside of
  the interpreter's knowledge, the current tool number is set to
  'manual-tool-number' (default 0) through the set-tool request pins.

Timeouts: if the component waits longer than 'timeout' for the press that opens
or for the press that closes the valve, an info message is emitted and the
corresponding timeout pin goes high. The message repeats every 'timeout'
seconds until the operator reacts. The timeout pins are meant to be routed into
the existing faultlatch/faultmsg message layer.

NON-SAFE: this component only sequences a valve and a lamp. Tool clamping power
stays behind the safe output (EK1914 Output 2) and the spindle interlock. Never
rely on these pins for a protective function.
""";

// -- gating ----------------------------------------------------------------
pin in bit enable "Component gate, typically halui.machine.is-on. Low aborts a running sequence and closes the valve.";
pin in bit spindle-stopped "High while the spindle is at standstill. Required to open the valve and to start a manual change.";

// -- field I/O -------------------------------------------------------------
pin in bit button "Release button (EL1819 input). Rising edge, debounced by 'button-debounce'.";
pin out bit lamp "Button lamp (EL2809 output). Pattern is generated by this component.";
pin out bit valve "Hydraulic clamp release valve (EL2024 output). High = tool released.";

// -- iocontrol handshake ---------------------------------------------------
pin in bit tool-change "iocontrol.0.tool-change: interpreter requests a tool change.";
pin out bit tool-changed "iocontrol.0.tool-changed: acknowledge, held until tool-change drops.";
pin in s32 tool-number = 0 "iocontrol.0.tool-number, used for the info messages only.";

// -- manual tool number handling ------------------------------------------
pin out bit set-tool-request "Request to the userspace helper: set the current tool to 'set-tool-number'.";
pin out s32 set-tool-number "Tool number handed to the userspace helper with the request.";
pin in bit set-tool-ack "Acknowledge from the userspace helper, clears the request early.";

// -- status ----------------------------------------------------------------
pin out bit program-pause "Pulse towards halui.program.pause when a change starts. The program then stays paused after the change until the operator resumes it.";
pin out bit change-active "High while a tool change sequence is running (either source).";
pin out bit manual-change "High while the running sequence was started at the button, not by M6.";
pin out bit timeout-open "High while the component waits too long for the opening press.";
pin out bit timeout-close "High while the component waits too long for the closing press.";
pin out s32 state "Current state: 0 idle, 1 wait-open, 2 open, 3 closing, 4 finish.";

// -- tuning ----------------------------------------------------------------
param rw float blink-wait = 1.0 "Period of the slow blink while waiting for the opening press [s].";
param rw float flash-on = 0.12 "Length of a single flash of the double flash pattern [s].";
param rw float flash-period = 1.2 "Repetition period of the double flash pattern [s].";
param rw float clamp-time = 1.5 "Time the valve stays closed before the change is reported complete [s].";
param rw float timeout = 60.0 "Waiting time before an info message is emitted [s].";
param rw float button-debounce = 0.03 "Debounce time of the release button [s].";
param rw float set-tool-pulse = 1.0 "Maximum length of the set-tool request pulse [s].";
param rw float pause-pulse = 0.2 "Length of the program-pause pulse [s].";
param rw bit pause-on-change = 1 "Pulse program-pause when a tool change starts.";
param rw bit require-spindle-stopped = 1 "Opening the valve requires spindle-stopped.";
param rw s32 manual-tool-number = 0 "Tool number written when a change is started at the button.";

variable int v_state = 0;
variable int v_manual = 0;
variable int v_btn_raw = 0;
variable int v_btn_stable = 0;
variable int v_warned = 0;
variable double v_btn_timer = 0.0;
variable double v_phase = 0.0;
variable double v_timer = 0.0;
variable double v_set_timer = 0.0;
variable double v_pause_timer = 0.0;

function _ "Tool clamp state machine, run in the servo thread after lcec.read-all";

license "GPL";
;;

#define ST_IDLE      0
#define ST_WAIT_OPEN 1
#define ST_OPEN      2
#define ST_CLOSE     3
#define ST_FINISH    4

#define MSG_PFX "mh400e_toolchange: "

FUNCTION(_) {
    int btn_edge = 0;
    int may_open;

    /* ------------------------------------------------------------------
     * 1. Button conditioning: debounce and rising edge detection.
     *    A press is only accepted after the input has been stable for
     *    'button-debounce', which also enforces a release between the
     *    two presses of one sequence.
     * ------------------------------------------------------------------ */
    if (button != v_btn_raw) {
        v_btn_raw = button;
        v_btn_timer = 0.0;
    } else if (v_btn_stable != v_btn_raw) {
        v_btn_timer += fperiod;
        if (v_btn_timer >= button_debounce) {
            v_btn_stable = v_btn_raw;
            if (v_btn_stable) {
                btn_edge = 1;
            }
        }
    }

    /* ------------------------------------------------------------------
     * 2. Set-tool request pulse towards the userspace helper. The request
     *    is dropped on acknowledge, or after 'set-tool-pulse' at the
     *    latest so that a missing helper cannot block the machine.
     * ------------------------------------------------------------------ */
    if (set_tool_request) {
        v_set_timer += fperiod;
        if (set_tool_ack || v_set_timer >= set_tool_pulse) {
            set_tool_request = 0;
            v_set_timer = 0.0;
        }
    }

    /* ------------------------------------------------------------------
     * 2b. Program pause pulse. halui evaluates the rising edge, so a short
     *     pulse is enough. The program stays paused after the change until
     *     the operator resumes it deliberately - this prevents the spindle
     *     from restarting while somebody is still at the tool.
     * ------------------------------------------------------------------ */
    if (program_pause) {
        v_pause_timer += fperiod;
        if (v_pause_timer >= pause_pulse) {
            program_pause = 0;
            v_pause_timer = 0.0;
        }
    }

    /* ------------------------------------------------------------------
     * 3. Global gate. Machine off closes the valve and drops the lamp
     *    immediately, a running sequence is discarded.
     * ------------------------------------------------------------------ */
    if (!enable) {
        if (v_state != ST_IDLE) {
            rtapi_print_msg(RTAPI_MSG_INFO,
                MSG_PFX "tool change aborted in state %d, machine is off\n",
                v_state);
        }
        v_state = ST_IDLE;
        v_manual = 0;
        v_timer = 0.0;
        v_phase = 0.0;
        v_warned = 0;
        valve = 0;
        lamp = 0;
        tool_changed = 0;
        change_active = 0;
        manual_change = 0;
        timeout_open = 0;
        timeout_close = 0;
        program_pause = 0;
        state = v_state;
        return;
    }

    /* Free running phase for the lamp patterns */
    v_phase += fperiod;

    may_open = (!require_spindle_stopped || spindle_stopped);

    /* ------------------------------------------------------------------
     * 4. State machine
     * ------------------------------------------------------------------ */
    switch (v_state) {

    /* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
     * IDLE: no change running. The lamp is steady on whenever the spindle
     *       stands still, signalling that a manual change is possible.
     * - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - */
    case ST_IDLE:
        valve = 0;
        tool_changed = 0;
        change_active = 0;
        manual_change = 0;
        timeout_open = 0;
        timeout_close = 0;
        lamp = spindle_stopped ? 1 : 0;

        if (tool_change) {
            /* Change requested by the interpreter: wait for confirmation
             * before the tool is released. */
            v_manual = 0;
            v_state = ST_WAIT_OPEN;
            v_timer = 0.0;
            v_phase = 0.0;
            v_warned = 0;
            if (pause_on_change) {
                program_pause = 1;
                v_pause_timer = 0.0;
            }
            rtapi_print_msg(RTAPI_MSG_INFO,
                MSG_PFX "tool change requested by interpreter, "
                "waiting for release button (current tool %d)\n",
                (int)tool_number);
        } else if (btn_edge && may_open) {
            /* Change started at the button: this press already is the
             * opening press, the valve follows immediately. */
            v_manual = 1;
            v_state = ST_OPEN;
            v_timer = 0.0;
            v_phase = 0.0;
            v_warned = 0;
            set_tool_number = manual_tool_number;
            set_tool_request = 1;
            v_set_timer = 0.0;
            if (pause_on_change) {
                program_pause = 1;
                v_pause_timer = 0.0;
            }
            rtapi_print_msg(RTAPI_MSG_INFO,
                MSG_PFX "manual tool change started at the button, "
                "current tool set to %d\n",
                (int)manual_tool_number);
        }
        break;

    /* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
     * WAIT_OPEN: M6 pending, valve still closed. Slow blink asks the
     *            operator to confirm the release.
     * - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - */
    case ST_WAIT_OPEN:
        valve = 0;
        tool_changed = 0;
        change_active = 1;
        manual_change = 0;

        /* Symmetric slow blink */
        if (v_phase >= blink_wait) {
            v_phase -= blink_wait;
        }
        lamp = (v_phase < 0.5 * blink_wait) ? 1 : 0;

        v_timer += fperiod;
        if (v_timer >= timeout) {
            v_timer = 0.0;
            v_warned++;
            timeout_open = 1;
            rtapi_print_msg(RTAPI_MSG_INFO,
                MSG_PFX "waiting %d min for the release button, "
                "valve still closed\n",
                v_warned * (int)(timeout / 60.0 + 0.5));
        }

        if (!tool_change) {
            /* Interpreter withdrew the request */
            v_state = ST_IDLE;
            rtapi_print_msg(RTAPI_MSG_INFO,
                MSG_PFX "tool change request withdrawn before release\n");
        } else if (btn_edge && may_open) {
            v_state = ST_OPEN;
            v_timer = 0.0;
            v_phase = 0.0;
            v_warned = 0;
            timeout_open = 0;
        }
        break;

    /* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
     * OPEN: valve energised, tool free. Double flash asks for the second
     *       press that clamps the tool back into the taper.
     * - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - */
    case ST_OPEN:
        valve = 1;
        tool_changed = 0;
        change_active = 1;
        manual_change = v_manual ? 1 : 0;

        /* Double flash: on - off - on - long pause */
        if (v_phase >= flash_period) {
            v_phase -= flash_period;
        }
        if (v_phase < flash_on) {
            lamp = 1;
        } else if (v_phase >= 2.0 * flash_on && v_phase < 3.0 * flash_on) {
            lamp = 1;
        } else {
            lamp = 0;
        }

        v_timer += fperiod;
        if (v_timer >= timeout) {
            v_timer = 0.0;
            v_warned++;
            timeout_close = 1;
            rtapi_print_msg(RTAPI_MSG_INFO,
                MSG_PFX "valve open for %d min, "
                "press the button to clamp the tool\n",
                v_warned * (int)(timeout / 60.0 + 0.5));
        }

        if (btn_edge) {
            v_state = ST_CLOSE;
            v_timer = 0.0;
            v_warned = 0;
            timeout_close = 0;
        }
        break;

    /* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
     * CLOSE: valve de-energised, the drawbar pulls the tool into the
     *        taper. Lamp off for 'clamp-time' as a visual hands-off cue.
     * - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - */
    case ST_CLOSE:
        valve = 0;
        lamp = 0;
        tool_changed = 0;
        change_active = 1;

        v_timer += fperiod;
        if (v_timer >= clamp_time) {
            v_state = ST_FINISH;
            v_timer = 0.0;
        }
        break;

    /* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
     * FINISH: report completion. A manual change needs no handshake, an
     *         M6 is acknowledged until the interpreter drops tool-change.
     * - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - */
    case ST_FINISH:
        valve = 0;
        change_active = 1;
        lamp = spindle_stopped ? 1 : 0;

        if (v_manual) {
            tool_changed = 0;
            v_state = ST_IDLE;
            v_manual = 0;
            rtapi_print_msg(RTAPI_MSG_INFO,
                MSG_PFX "manual tool change finished, tool clamped\n");
        } else {
            tool_changed = 1;
            if (!tool_change) {
                tool_changed = 0;
                v_state = ST_IDLE;
                rtapi_print_msg(RTAPI_MSG_INFO,
                    MSG_PFX "tool change finished, tool %d clamped\n",
                    (int)tool_number);
            }
        }
        break;

    default:
        /* Should never happen - fall back to a safe state */
        rtapi_print_msg(RTAPI_MSG_ERR,
            MSG_PFX "unknown state %d, resetting to idle\n", v_state);
        v_state = ST_IDLE;
        valve = 0;
        lamp = 0;
        tool_changed = 0;
        break;
    }

    state = v_state;
}
