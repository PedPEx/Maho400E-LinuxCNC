# ============================================================================
# fc302_spindle.hal      ->  components/spindle/fc302_spindle.hal
#
# Core wiring for the MAHO MH400E spindle drive component (fc302_spindle).
# This file is ALWAYS loaded and has no GUI dependencies.
#
# INI:
#   [HAL]
#   HALFILE = components/spindle/fc302_spindle.hal
#
# IMPORTANT - this component replaces cia402.0 for the spindle:
#   The CiA402 state machine lives inside fc302-spindle so the drive can be
#   held at SWITCHED ON (ready, power stage off) before going to OPERATION
#   ENABLED.  cia402.0 only offers a single .enable pin and always goes
#   straight to OPERATION ENABLED, which is why it cannot do this.
#   The whole cia402 block in 3Axes_conf.hal must be removed, including the
#   loadrt/addf of cia402 and the conv-u32-s32 that only fed its opmode.
#
# WHO DRIVES speed-cmd AND activate:
#   Since mh400e_spindle_master exists, those two come from the master, see
#   components/spindle/mh400e_spindle_master.hal.  They are deliberately NOT
#   wired here.  Twitching is the exception: the gearbox drives
#   fc302-spindle.twitch directly and that brings the power stage up on its
#   own, without activate.
#
# CONTROLLED RAMP-DOWN BEFORE THE BRAKE (M5 and machine-off):
#   The component no longer coasts on a normal stop.  It holds the drive in
#   OPERATION ENABLED with a zero setpoint so the FC302 ramps the motor down
#   over par 3-42, the brake resistor takes the energy and the FC302 closes the
#   mechanical brake at standstill (par 2-21).  Only then is the power stage
#   released.  See the "enable" wiring note below for the machine-off case.
#
# Remember: halcompile turns underscores into hyphens for HAL names, so the
# module is loaded as fc302_spindle but addressed as fc302-spindle.
# ============================================================================

loadrt fc302_spindle
addf   fc302-spindle servo-thread

# ===========================================================================
# Drive interface (CiA402 over lcec)
#
# The signal names below are reused by the OPTIONAL status panel
# (fc302_status.hal), which attaches to them as additional SINKS.  A HAL
# signal may have only one source but any number of sinks, so the panel never
# has to touch these lcec pins itself - that is what keeps the panel
# switchable from the INI without breaking this file.
# ===========================================================================

net fc302-status     lcec.m0.FC302.srv-cia-statusword  => fc302-spindle.statusword
net fc302-ctrl       fc302-spindle.controlword         => lcec.m0.FC302.srv-cia-controlword

# Speed setpoint: the component emits s32 RPM directly, no conv_float_s32.
net fc302-target-vl  fc302-spindle.speed-out           => lcec.m0.FC302.srv-target-vl

# ===========================================================================
# Feedback used by the supervision
# ===========================================================================
net fc302-fb-rpm     lcec.m0.FC302.Infos-RO-PDO.feedback-rpm       => fc302-spindle.feedback-rpm
net fc302-torque-pct lcec.m0.FC302.Infos-RO-PDO.torque-pct-highres => fc302-spindle.torque-pct
net fc302-t-card     lcec.m0.FC302.Infos-RO-PDO.ctrl-card-temp     => fc302-spindle.ctrl-card-temp
net fc302-t-heatsink lcec.m0.FC302.Infos-RO.heatsink-temp          => fc302-spindle.heatsink-temp
net fc302-t-motor    lcec.m0.FC302.Infos-RO.kty-temperature        => fc302-spindle.motor-temp

# ===========================================================================
# Machine state, hard release (enable) and acknowledge
#
# machine-on gates the run request and ALL drive-side faults (3..5
# temperatures, 6 CiA402 FAULT, 7 not remote).  With the machine off the safety
# logic holds STO low, the FC302 sits in FAULT legitimately and the feedback
# PDOs are not valid yet - none of that must latch here.  On the rising edge
# the component also sends one fault reset to the drive (auto-fault-reset).
#
#   machine-on -> run request + fault evaluation window
#   enable     -> hard power release (STO permit): drive up to SWITCHED ON
#
# ---------------------------------------------------------------------------
# enable = HARD RELEASE / STO PERMIT.  READ THIS - it decides machine-off:
#
#   For the controlled ramp-down to also work on machine-off (F2), the drive
#   must stay electrically enabled through the ramp.  That means "enable" must
#   come from a signal that is TRUE except on Not-Halt (the STO-OK / safe
#   torque-on feedback from the TwinSAFE logic), NOT from machine-on.  On
#   Not-Halt that signal drops, the component disables voltage at once and the
#   hardwired brake closes immediately - which is exactly what a Not-Halt
#   should do.
#
#   To sequence the machine-off / STO drop behind the ramp-down, gate the
#   power-down on fc302-spindle.stopping being FALSE (and spindle-stopped
#   TRUE) in the safety / shutdown logic.
#
#   COMMISSIONING DEFAULT below ties enable to machine-is-on.  With that,
#   M5 ramps down correctly (machine stays on), but machine-off will COAST,
#   because enable drops together with machine-on.  Replace the default line
#   with your STO-OK signal to get the ramp-down on machine-off as well:
#
#       net safe-sto-ok  <your-twinsafe-sto-ok-pin>  => fc302-spindle.enable
#
#   and delete the "net machine-is-on => fc302-spindle.enable" line.
# ---------------------------------------------------------------------------
#
# 'machine-is-on' is sourced by halui.machine.is-on in 3Axes_conf.hal and
# 'ack-btn' by the acknowledge button, so those lines are pure SINKS here
# - do not add a source pin.
# ===========================================================================
net machine-is-on  => fc302-spindle.machine-on

# Commissioning default: enable = machine-is-on (M5 ramps, machine-off coasts).
# See the note above to switch this to your STO-OK signal for ramp-down on
# machine-off too.
net machine-is-on  => fc302-spindle.enable

net ack-btn        => fc302-spindle.fault-reset

# ===========================================================================
# Status signals
#
# 'drive-ready' carries fc302-spindle.drive-active and replaces what used to
# be cia402.0.stat-op-enabled, so the name is kept for the rest of the
# configuration even though it reports "power stage on".  A HAL pin may only
# ever be on ONE signal, which is why mh400e_spindle_master reads this very
# signal for its drive-active input instead of creating a second one.
# ===========================================================================
net drive-ready        fc302-spindle.drive-active

# Real "drive is ready" (SWITCHED ON or better), separate pin, separate signal.
net fc302-drive-rdy    fc302-spindle.drive-ready

# Target reached, status word bit 10.  Consumed by the master, which ANDs it
# with drive-active before handing it to spindle.0.at-speed - bit 10 is also
# set at standstill with a setpoint of 0.
net fc302-at-speed     fc302-spindle.at-speed

# Standstill, from the REAL feedback speed, held TRUE while the gearbox
# twitches and for twitch-settle-time-s afterwards.
#
# THIS LINE IS THE SOURCE of fc302-spdl-stopped.  Without it the signal exists
# with no writer, stays FALSE forever, and the gearbox runs into its
# "spindle did not come to a stop" fault on every single gear change.
net fc302-spdl-stopped fc302-spindle.spindle-stopped

# Controlled ramp-down in progress (after M5 / machine-off, before the power
# stage is released).  Exposed so the shutdown / safety logic can hold the
# machine-off or STO drop until the spindle has come to a stop.  Left as a
# pure source here; add sinks (e.g. a shutdown gate) where needed.
net fc302-spdl-stopping fc302-spindle.stopping

# Twitch phase, for the status panel.
net fc302-tw-active    fc302-spindle.twitch-active

# ===========================================================================
# Fault reporting to the central fault handler
#
# The warning and acknowledge lamps are owned by the fault handler
# (faultmsg.any-fault / any-ackable -> EL1859.dout-2 / dout-1), so this
# component does NOT drive lamps.  It only reports health.
#
# faultlatch.51 is created in faulthandler/faulthandler.hal (id 620); its
# monitor expects HIGH = OK, which is exactly fc302-spindle.health-ok.
# This line lives here (not in faulthandler.hal) so it runs after this
# component's pins exist - keep fc302_spindle.hal loaded AFTER
# faulthandler/faulthandler.hal in the INI.
# ===========================================================================
net fc302-spindle-health  fc302-spindle.health-ok  => faultlatch.51.monitor

# ===========================================================================
# Control inputs driven from elsewhere
#
#   speed-cmd, activate  <- mh400e_spindle_master.hal
#   twitch               <- mh400e_gearbox.hal (signal gb-twitch-request)
#
# For commissioning the master can be taken out of the loop by commenting its
# HALFILE line out; the pins can then be exercised by hand:
#   halcmd setp fc302-spindle.activate 1
#   halcmd setp fc302-spindle.speed-cmd 200
# ===========================================================================

# ===========================================================================
# Tuning (defaults shown as comments)
# ===========================================================================
setp fc302-spindle.rpm-settle-time-s      15.0
# setp fc302-spindle.stopped-rpm           10.0
setp fc302-spindle.stopped-delay-s        0.5
# setp fc302-spindle.fault-eval-delay-s     2.0
# setp fc302-spindle.auto-fault-reset          1

# ---- Controlled ramp-down before the brake ----
# brake-rampdown = 1 (default): a normal stop keeps the drive in OPERATION
# ENABLED with a zero setpoint so it ramps down over par 3-42, the resistor
# takes the energy and the FC302 closes the brake at standstill (par 2-21).
# Set the SOFTNESS of the ramp in the drive at par 3-42.  Set to 0 to restore
# the old immediate coast stop.
# setp fc302-spindle.brake-rampdown            1

# Safety cap: release the power stage after this long even if standstill is not
# reported (missing feedback / STO cut).  Must cover the ramp-down from top
# speed set in par 3-42.
setp fc302-spindle.stop-ramp-timeout-s   10.0

# How long spindle-stopped keeps reporting standstill after twitch drops.
# Must cover the coast-down, otherwise the gearbox waits for it before the
# next shift.  0 makes the pin fully honest again.
setp fc302-spindle.twitch-settle-time-s   3.0

# Temperature limits.  The FC302's own protection trips long before anything
# is damaged, so these are a plausibility guard, not the primary protection.
setp fc302-spindle.ctrl-card-temp-max    80.0
setp fc302-spindle.heatsink-temp-max     90.0
setp fc302-spindle.motor-temp-max       120.0

# Overload guard is DISABLED until the scaling of torque-pct-highres is known.
# Watch lcec.m0.FC302.Infos-RO-PDO.torque-pct-highres during normal cutting and
# during a blocked / stalled run, then set a threshold between the two:
# setp fc302-spindle.torque-limit-pct       0.0
# setp fc302-spindle.torque-limit-time-s    1.0

# Twitch timing / speed are pins, so the gearbox can drive them later:
setp fc302-spindle.twitch-speed     75.0
setp fc302-spindle.twitch-cw-time    1
setp fc302-spindle.twitch-ccw-time   1

net spindle-stopped fc302-spindle.spindle-standstill