# Startup-Meldung
setp faultlatch.33.id 199
setp faultlatch.33.startup 1        # latcht einmal beim Boot, manuell quittierbar
net startup-gate faultlatch.33.fault-interlock

# ----- ID 100  [alarm]  EtherCAT-Bus ohne Funktion  (faultlatch.0) -----
setp faultlatch.0.id 100
#   monitor <= buscheck.bus-alive   (wired in buscheck.hal, post-GUI)

# ----- ID 101  [alarm]  EtherCAT-Slave fehlt  (faultlatch.1) -----
setp faultlatch.1.id 101
#   monitor <= buscheck.slaves-complete   (wired in buscheck.hal, post-GUI)

# ----- ID 102  [alarm]  EtherCAT-Slave nicht OP  (faultlatch.2) -----
setp faultlatch.2.id 102
#   monitor <= buscheck.all-op   (wired in buscheck.hal, post-GUI)

# ----- ID 201  [warning]  SafetyPLC: keine Freigabe  (faultlatch.3) -----
setp faultlatch.3.id 201
net cond-201  lcec.m0.EL1918.safety-ok  => faultlatch.3.monitor

# ----- ID 202  [warning]  SafetyPLC: Error  (faultlatch.4) -----
setp faultlatch.4.id 202
#net cond-202  lcec.m0.EL1918.safety-ok  => faultlatch.4.monitor

# ----- ID 203  [warning]  Reserve  (faultlatch.5) -----
setp faultlatch.5.id 203
#net cond-203  <SIGNAL: HIGH=OK>  => faultlatch.5.monitor

# ----- ID 251  [alarm]  Endschalter X  (faultlatch.6) -----
setp faultlatch.6.id 251
net cond-251  lcec.m0.EK1914.din-0  => faultlatch.6.monitor

# ----- ID 252  [alarm]  Endschalter Y  (faultlatch.7) -----
setp faultlatch.7.id 252
net cond-252  lcec.m0.EK1914.din-1  => faultlatch.7.monitor

# ----- ID 253  [alarm]  Endschalter Z  (faultlatch.8) -----
setp faultlatch.8.id 253
net cond-253  lcec.m0.EK1914.din-2  => faultlatch.8.monitor

# ----- ID 254  [alarm]  NotHalt Bedienpult betaetigt  (faultlatch.9) -----
setp faultlatch.9.id 254
net cond-254  lcec.m0.EK1914.fsoe-in-0  => faultlatch.9.monitor

# ----- ID 255  [warning]  Indramat nicht betriebsbereit  (faultlatch.10) -----
setp faultlatch.10.id 255
net cond-255  lcec.m0.EL1918.local.in-4  => faultlatch.10.monitor

# ----- ID 256  [alarm]  Sicherung HMI ausgeloest  (faultlatch.11) -----
setp faultlatch.11.id 256
net cond-256  lcec.m0.EL1918.local.in-5  => faultlatch.11.monitor

# ----- ID 257  [alarm]  Sicherung DC-Kreise ausgeloest  (faultlatch.12) -----
setp faultlatch.12.id 257
net cond-257  lcec.m0.EL1918.local.in-6  => faultlatch.12.monitor

# ----- ID 258  [alarm]  Bremsen Manuell  (faultlatch.13) -----
setp faultlatch.13.id 258
net cond-258  lcec.m0.EL1918.local.in-7  => faultlatch.13.monitor

# ----- ID 259  [alarm]  Reserve  (faultlatch.14) -----
setp faultlatch.14.id 259
#net cond-259  <SIGNAL: HIGH=OK>  => faultlatch.14.monitor

# ----- ID 600  [alarm]  Motorschutzschalter Frequenzumrichter  (faultlatch.15) -----
setp faultlatch.15.id 600
net cond-600  lcec.m0.EL1819-0.din-0  => faultlatch.15.monitor

# ----- ID 601  [alarm]  Motorschutzschalter Kuehlmittelpumpe  (faultlatch.16) -----
setp faultlatch.16.id 601
net cond-601  lcec.m0.EL1819-0.din-1  => faultlatch.16.monitor

# ----- ID 602  [alarm]  Motorschutzschalter Hydraulikpumpe  (faultlatch.17) -----
setp faultlatch.17.id 602
net cond-602  lcec.m0.EL1819-0.din-2  => faultlatch.17.monitor

# ----- ID 603  [alarm]  Trafoschutzschalter DC-Motoren  (faultlatch.18) -----
setp faultlatch.18.id 603
net cond-603  lcec.m0.EL1819-0.din-3  => faultlatch.18.monitor

# ----- ID 604  [alarm]  Trafoschutzschalter 110 V System  (faultlatch.19) -----
setp faultlatch.19.id 604
net cond-604  lcec.m0.EL1819-0.din-4  => faultlatch.19.monitor

# ----- ID 605  [alarm]  Motorschutzschalter Indramat Logikversorgung  (faultlatch.20) -----
setp faultlatch.20.id 605
net cond-605  lcec.m0.EL1819-0.din-5  => faultlatch.20.monitor

# ----- ID 606  [alarm]  Sicherung 110 V: Motorbremse  (faultlatch.21) -----
setp faultlatch.21.id 606
net cond-606  lcec.m0.EL1819-0.din-6  => faultlatch.21.monitor

# ----- ID 607  [alarm]  Sicherung 110 V: Zentralschmierung  (faultlatch.22) -----
setp faultlatch.22.id 607
net cond-607  lcec.m0.EL1819-0.din-7  => faultlatch.22.monitor

# ----- ID 608  [warning]  Hydraulikpumpe: Fehler  (faultlatch.23) -----
setp faultlatch.23.id 608
net cond-608  lcec.m0.EL1819-0.din-8  => faultlatch.23.monitor

# ----- ID 609  [warning]  Zentralschmierung: Fehler  (faultlatch.24) -----
setp faultlatch.24.id 609
net cond-609  lcec.m0.EL1819-0.din-9  => faultlatch.24.monitor

# ----- ID 610  [info]  Hydraulikpumpe: Druck erreicht  (faultlatch.25) -----
setp faultlatch.25.id 610
setp faultlatch.25.auto-clear-s 5
net cond-610  lcec.m0.EL1819-0.din-10  => faultlatch.25.monitor

# ----- ID 611  [info]  Hydraulikpumpe: Pumpe laeuft  (faultlatch.26) -----
setp faultlatch.26.id 611
setp faultlatch.26.auto-clear-s 5
net cond-611  lcec.m0.EL1819-0.din-10-not  => faultlatch.26.monitor

# ----- ID 612  [alarm]  Uebertemperatur DC Achsmotoren  (faultlatch.27) -----
setp faultlatch.27.id 612
net cond-612  lcec.m0.EL1819-0.din-11  => faultlatch.27.monitor

# ----- ID 613  [alarm]  Uebertemperatur Transformator  (faultlatch.28) -----
setp faultlatch.28.id 613
net cond-613  lcec.m0.EL1819-0.din-12  => faultlatch.28.monitor

# ----- ID 614  [alarm]  Reserve ID614  (faultlatch.29) -----
setp faultlatch.29.id 614
#net cond-614  <SIGNAL: HIGH=OK>  => faultlatch.29.monitor

# ----- ID 615  [alarm]  Reserve ID615  (faultlatch.30) -----
setp faultlatch.30.id 615
#net cond-615  <SIGNAL: HIGH=OK>  => faultlatch.30.monitor

# ----- ID 616  [alarm]  Reserve ID616  (faultlatch.31) -----
setp faultlatch.31.id 616
#net cond-616  <SIGNAL: HIGH=OK>  => faultlatch.31.monitor

# ----- ID 617  [alarm]  Indramatfreigabe Manuell  (faultlatch.32) -----
setp faultlatch.32.id 617
net cond-617  lcec.m0.EL1859.din-2  => faultlatch.32.monitor

# ----- ID 620  [alarm]  FC302 Spindel: Fehler  (faultlatch.51) -----
setp faultlatch.51.id 620
net startup-gate faultlatch.51.inhibit
#   monitor <= fc302-spindle.health-ok   (wired in components/spindle/fc302_spindle.hal)

# ----- ID 630  [alarm]  MH400E Getriebe: Schaltfehler  (faultlatch.52) -----
setp faultlatch.52.id 630
net startup-gate faultlatch.52.inhibit
#   monitor <= mh400e-gearbox-el7332.health-ok   (wired in components/Gearbox/mh400e_gearbox_el7332.hal)

# ----- ID 640  [alarm]  MH400E Spindelsteuerung: Fehler  (faultlatch.53) -----
setp faultlatch.53.id 640
net startup-gate faultlatch.53.inhibit
#   monitor <= mh400e-spindle-master.health-ok   (wired in components/spindle/mh400e_spindle_master.hal)

# ----- ID 641  [info]  Spindel gesperrt: Werkzeugwechsel laeuft  (faultlatch.54) -----
setp faultlatch.54.id 641
net startup-gate faultlatch.54.inhibit
#   monitor <= mh400e-spindle-master.toolchange-ok   (wired in components/spindle/mh400e_spindle_master.hal)

# ----- Acknowledge button to every instance (falling edge = ack) -----
