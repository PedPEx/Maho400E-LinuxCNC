/*
 * bec_enc_homing.comp
 *
 * LinuxCNC HAL component: Beckhoff encoder terminal homing adapter.
 *
 * Bridges the Beckhoff hardware C-input latch (EL5021, EL5101, EP5101,
 * EL5101-0010 and similar terminals) to the standard LinuxCNC encoder
 * index-enable homing interface.
 *
 * Background
 * ----------
 * Beckhoff encoder terminals do NOT reset their counter on a reference mark.
 * They capture the counter into a latch register and set "latch C valid".
 * LinuxCNC must therefore be configured with:
 *
 *   HOME_USE_INDEX              = YES
 *   HOME_INDEX_NO_ENCODER_RESET = YES
 *
 * With HOME_INDEX_NO_ENCODER_RESET, LinuxCNC samples motor-pos-fb in the
 * servo cycle in which index-enable goes FALSE and derives the joint offset
 * from that value. The component therefore never shifts its position frame;
 * it only hands LinuxCNC the exact latched position for that single cycle.
 *
 * Single index pass
 * -----------------
 * LinuxCNC asserts index-enable for exactly ONE index search: it moves at
 * HOME_LATCH_VEL towards the mark and waits for index-enable to drop. There
 * is no back-off and re-approach during the index phase. This component
 * consequently accepts the first valid latch event and completes homing
 * immediately. (Earlier revisions waited for a second latch, which never
 * arrives in index-only homing and caused the axis to run past the mark.)
 *
 * Latch event handling
 * --------------------
 *   - Before arming, enable-latch-c is held LOW until the terminal has
 *     withdrawn any old latch-c-valid flag (CLEAR state, bounded by
 *     clear-timeout).
 *   - While armed, only a LOW->HIGH transition of latch-c-valid is accepted
 *     as a new event. A flag that is already HIGH is stale and ignored.
 *     This is independent of the EtherCAT round-trip latency (2-3 cycles).
 *   - The latched raw value is mapped into the accumulated position frame
 *     via the signed difference (latch-value - counter-value). This is
 *     wrap-around safe and works regardless of the absolute counter value.
 *   - Plausibility check: if |latch-value - counter-value| exceeds
 *     latch-tolerance counts, the event is rejected, latch-fault is set and
 *     the latch is re-armed. This catches a latch register that does not
 *     share the counter's resolution/reference (which would otherwise cause
 *     a feedback step and an immediate following error at the mark).
 *   - If motion drops index-enable while waiting (E-stop, following error,
 *     homing aborted), the component returns to IDLE and de-arms, so the
 *     next attempt starts from a clean state.
 *
 * Position output
 * ---------------
 * The raw UINT32 counter is accumulated with two's-complement deltas into a
 * double (exact for integers up to 2^53), initialised to the current raw
 * counter on the first cycle. position = accumulated counts / scale.
 *
 * Required terminal pins (lcec):
 *   enc.counter-value   (u32, HAL_OUT from driver)
 *   enc.latch-value     (u32, HAL_OUT from driver)
 *   enc.latch-c-valid   (bit, HAL_OUT from driver)
 *   enc.enable-latch-c  (bit, HAL_IN  to driver)
 * Optional (kept for wiring compatibility, always driven FALSE / 0):
 *   enc.set-counter     (bit, HAL_IN  to driver)
 *   enc.set-counter-value (u32, HAL_IN to driver)
 *
 * The terminal must NOT be configured to reset its counter on the C input
 * (EL5021: 8000:01 "Enable C reset" = FALSE, lcec modParam enableCReset).
 *
 * HAL usage example (EL5021 via lcec):
 *
 *   loadrt bec_enc_homing names=bec-enc-x,bec-enc-y,bec-enc-z
 *
 *   net y-enc-cnt    lcec.0.enc-y.enc.counter-value  => bec-enc-y.raw-count
 *   net y-latch-val  lcec.0.enc-y.enc.latch-value    => bec-enc-y.latch-value
 *   net y-latch-ok   lcec.0.enc-y.enc.latch-c-valid  => bec-enc-y.latch-c-valid
 *   net y-latch-arm  bec-enc-y.enable-latch-c        => lcec.0.enc-y.enc.enable-latch-c
 *   net y-pos        bec-enc-y.position              => joint.1.motor-pos-fb
 *   net y-idx-en     joint.1.index-enable           <=> bec-enc-y.index-enable
 *
 *   setp bec-enc-y.scale            [JOINT_1]ENCODER_SCALE
 *   setp bec-enc-y.latch-tolerance  5120   # counts; 0.1 mm at 51200 counts/mm
 *
 *   # Servo thread order: after lcec.read-all, before motion-command-handler
 *   addf bec-enc-y servo-thread
 *
 * INI (per joint):
 *   HOME_USE_INDEX              = YES
 *   HOME_INDEX_NO_ENCODER_RESET = YES
 *   HOME_SEARCH_VEL             = 0.0     # index-only homing
 *   HOME_LATCH_VEL              = +/-1.0  # direction towards the mark
 *
 * Diagnostics (halscope): state, latch-c-valid, enable-latch-c, raw-count,
 * latch-value, latch-delta, index-enable, position, joint.N.f-error.
 *
 * State encoding (state-out):
 *   0 = IDLE      not homing
 *   1 = CLEAR     arm held LOW, waiting for stale latch flag to clear
 *   2 = ARMED     arm HIGH, waiting for LOW->HIGH edge of latch-c-valid
 *   3 = COMPLETE  latch accepted, index-enable cleared (one cycle)
 *   4 = ERROR     configuration error (scale == 0), reload required
 *
 * Revision notes:
 *   - Two-pass state machine replaced by single-pass (see above).
 *   - Pins first-latch-count / second-latch-count replaced by latch-count,
 *     latch-delta and latch-position; new pin latch-fault.
 *   - State numbering changed.
 *   - Params reset-on-home, home-count, latch-arm-cycles are retained only
 *     so existing HAL files keep loading; they have no effect.
 *   - Position arithmetic now in double (was single-precision float).
 *
 * License: GPL v2 or later
 */

component bec_enc_homing
    "Beckhoff encoder terminal homing adapter, single-pass C-latch index homing";

/* =========================================================================
 * Inputs from the encoder terminal driver
 * ========================================================================= */
pin in  u32   raw_count "Raw UINT32 counter value from terminal (enc.counter-value).";
pin in  u32   latch_value "Latched counter value captured on C-input event (enc.latch-value).";
pin in  bit   latch_c_valid "TRUE while a captured C-input latch event is present (enc.latch-c-valid).";

/* =========================================================================
 * Outputs to the encoder terminal driver
 * ========================================================================= */
pin out bit   enable_latch_c = 0 "Arm the hardware C-input latch (enc.enable-latch-c).";
pin out bit   set_counter = 0 "Unused, always FALSE. Kept for wiring compatibility (enc.set-counter).";
pin out u32   set_counter_value = 0 "Unused, always 0. Kept for wiring compatibility (enc.set-counter-value).";

/* =========================================================================
 * LinuxCNC motion interface
 * ========================================================================= */
pin io  bit   index_enable = 0 "Connect to joint.N.index-enable. Motion sets TRUE to start the index search, component clears it on the accepted latch.";
pin out float position = 0.0 "Scaled encoder position in machine units. Connect to joint.N.motor-pos-fb.";
pin out s32   counts = 0 "Accumulated encoder counts (clamped to s32 range). Diagnostic.";

/* =========================================================================
 * Status / diagnostic outputs
 * ========================================================================= */
pin out u32   state_out = 0 "State: 0=IDLE 1=CLEAR 2=ARMED 3=COMPLETE 4=ERROR";
pin out bit   homed = 0 "TRUE after an accepted latch. Cleared when a new homing request starts.";
pin out bit   latch_fault = 0 "TRUE if a latch event was rejected by the latch-tolerance check.";
pin out s32   latch_count = 0 "Raw latch value of the last latch event (as s32). Diagnostic.";
pin out s32   latch_delta = 0 "latch-value minus counter-value at the last latch event, in counts. Diagnostic.";
pin out float latch_position = 0.0 "Position (machine units, component frame) of the last accepted latch.";

/* =========================================================================
 * Parameters
 * ========================================================================= */
param rw float scale = 1.0 "Encoder scale in counts per machine unit (e.g. 51200 for 20 um pitch with 10-bit interpolation). Must not be zero; sign sets direction.";
param rw s32   latch_tolerance = 5120 "Maximum accepted |latch-value - counter-value| in counts at the moment of the event. 0 disables the check.";
param rw s32   clear_timeout = 50 "Servo cycles to wait for a stale latch-c-valid to clear before arming anyway.";
param rw bit   reset_on_home = 0 "Deprecated, no effect. Retained so existing HAL files load.";
param rw s32   home_count = 0 "Deprecated, no effect. Retained so existing HAL files load.";
param rw s32   latch_arm_cycles = 2 "Deprecated, no effect. Retained so existing HAL files load.";

/* -------------------------------------------------------------------------
 * Per-instance variables (must precede ';;', basic C types only).
 * ------------------------------------------------------------------------- */
variable int      v_state             = 0;
variable int      v_timer             = 0;
variable unsigned v_last_raw          = 0;
variable double   v_accum             = 0.0;
variable int      v_first_cycle       = 1;
variable int      v_prev_index_enable = 0;
variable int      v_prev_latch_valid  = 0;
variable int      v_publish_latch     = 0;
variable double   v_publish_value     = 0.0;
variable int      v_deprecation_done  = 0;

function _;
license "GPL";
author  "MAHO MH400E LinuxCNC retrofit project";

;;

#define STATE_IDLE      0
#define STATE_CLEAR     1
#define STATE_ARMED     2
#define STATE_COMPLETE  3
#define STATE_ERROR     4

/* Clamp a double count value into the s32 range for the diagnostic pin. */
static hal_s32_t clamp_s32(double v)
{
    if (v >  2147483647.0) return  2147483647;
    if (v < -2147483648.0) return (hal_s32_t)(-2147483647 - 1);
    return (hal_s32_t)v;
}

FUNCTION(_)
{
    hal_u32_t cur    = raw_count;
    int       cur_lv = latch_c_valid ? 1 : 0;
    int       cur_ie = index_enable ? 1 : 0;

    /* Counter preset is not used by this component */
    set_counter       = 0;
    set_counter_value = 0;

    /* One-time notice for deprecated parameters */
    if (!v_deprecation_done) {
        if (reset_on_home) {
            rtapi_print_msg(RTAPI_MSG_WARN,
                "bec_enc_homing: reset-on-home is deprecated and ignored\n");
        }
        v_deprecation_done = 1;
    }

    /* ------------------------------------------------------------------
     * 0. Configuration check
     * ------------------------------------------------------------------ */
    if (scale == 0.0) {
        if (v_state != STATE_ERROR) {
            rtapi_print_msg(RTAPI_MSG_ERR,
                "bec_enc_homing: scale is zero - component halted, "
                "set a non-zero scale and reload\n");
            v_state = STATE_ERROR;
        }
        enable_latch_c = 0;
        state_out      = STATE_ERROR;
        v_prev_latch_valid  = cur_lv;
        v_prev_index_enable = cur_ie;
        return;
    }

    /* ------------------------------------------------------------------
     * 1. Accumulate position from the raw counter (wrap-around safe)
     * ------------------------------------------------------------------ */
    if (v_first_cycle) {
        /* Start at the current raw value so accumulator and latch register
         * share the same reference frame from the first cycle on. */
        v_last_raw    = cur;
        v_accum       = (double)cur;
        v_first_cycle = 0;
    } else {
        hal_s32_t delta = (hal_s32_t)(cur - v_last_raw);
        v_accum   += (double)delta;
        v_last_raw = cur;
    }

    position = v_accum / scale;
    counts   = clamp_s32(v_accum);

    /* ------------------------------------------------------------------
     * 2. Homing request / abort detection
     * ------------------------------------------------------------------ */
    if (cur_ie && !v_prev_index_enable) {
        /* Rising edge: motion starts the index search */
        v_state         = STATE_CLEAR;
        v_timer         = (clear_timeout > 0) ? clear_timeout : 1;
        homed           = 0;
        latch_fault     = 0;
        v_publish_latch = 0;
        rtapi_print_msg(RTAPI_MSG_DBG,
            "bec_enc_homing: homing requested\n");
    } else if (!cur_ie && v_prev_index_enable &&
               (v_state == STATE_CLEAR || v_state == STATE_ARMED)) {
        /* Motion dropped index-enable while we were still waiting:
         * homing aborted (E-stop, following error, cancel). */
        v_state = STATE_IDLE;
        rtapi_print_msg(RTAPI_MSG_INFO,
            "bec_enc_homing: homing aborted by motion, latch de-armed\n");
    }

    /* ------------------------------------------------------------------
     * 3. State machine
     * ------------------------------------------------------------------ */
    switch (v_state) {

    case STATE_IDLE:
        enable_latch_c = 0;
        break;

    case STATE_CLEAR:
        /* Hold the arm LOW until the terminal has withdrawn any old flag */
        enable_latch_c = 0;
        if (!cur_lv) {
            v_state = STATE_ARMED;
            rtapi_print_msg(RTAPI_MSG_DBG,
                "bec_enc_homing: latch state clean, armed\n");
        } else if (--v_timer <= 0) {
            /* Arm anyway: the edge detection below still refuses to
             * consume a flag that never went LOW. */
            v_state = STATE_ARMED;
            rtapi_print_msg(RTAPI_MSG_ERR,
                "bec_enc_homing: latch-c-valid stuck HIGH for %d cycles - "
                "arming anyway, check terminal wiring/config\n",
                (int)clear_timeout);
        }
        break;

    case STATE_ARMED:
        enable_latch_c = 1;

        /* Accept only a genuine LOW->HIGH transition while armed */
        if (cur_lv && !v_prev_latch_valid) {
            hal_s32_t d  = (hal_s32_t)(latch_value - cur);
            long long ad = (d < 0) ? -(long long)d : (long long)d;

            latch_count = (hal_s32_t)latch_value;
            latch_delta = d;

            if (latch_tolerance > 0 && ad > (long long)latch_tolerance) {
                /* Latch register does not match the counter frame:
                 * reject instead of producing a feedback step. */
                latch_fault    = 1;
                enable_latch_c = 0;
                v_state        = STATE_CLEAR;
                v_timer        = (clear_timeout > 0) ? clear_timeout : 1;
                rtapi_print_msg(RTAPI_MSG_ERR,
                    "bec_enc_homing: latch rejected, latch-counter delta = "
                    "%d counts (tolerance %d) - re-arming\n",
                    (int)d, (int)latch_tolerance);
            } else {
                /* Exact position of the reference mark in our frame */
                v_publish_value = v_accum + (double)d;
                v_publish_latch = 1;
                latch_position  = v_publish_value / scale;
                homed           = 1;

                /* Single index pass: tell motion the index was found */
                index_enable   = 0;
                enable_latch_c = 0;
                v_state        = STATE_COMPLETE;
            }
        }
        break;

    case STATE_COMPLETE:
        enable_latch_c = 0;
        rtapi_print_msg(RTAPI_MSG_INFO,
            "bec_enc_homing: homing complete, latch = %d, delta = %d counts\n",
            (int)latch_count, (int)latch_delta);
        v_state = STATE_IDLE;
        break;

    case STATE_ERROR:
        enable_latch_c = 0;
        break;

    default:
        rtapi_print_msg(RTAPI_MSG_ERR,
            "bec_enc_homing: unknown state %d - resetting to IDLE\n",
            v_state);
        v_state        = STATE_IDLE;
        enable_latch_c = 0;
        break;
    }

    state_out = (hal_u32_t)v_state;

    /* ------------------------------------------------------------------
     * 4. Publish the exact latched position for this single cycle.
     *
     *    Must happen in the same cycle in which index-enable is cleared:
     *    motion-command-handler runs later in the servo thread and samples
     *    motor-pos-fb exactly then. From the next cycle on the live
     *    position is published again; the difference is the distance
     *    travelled since the event (a few um at HOME_LATCH_VEL).
     * ------------------------------------------------------------------ */
    if (v_publish_latch) {
        position = v_publish_value / scale;
        counts   = clamp_s32(v_publish_value);
        v_publish_latch = 0;
    }

    /* Edge-detection history (index-enable after our own write) */
    v_prev_latch_valid  = cur_lv;
    v_prev_index_enable = index_enable ? 1 : 0;
}
