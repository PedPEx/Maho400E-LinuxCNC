			<!-- <modParam name="enableUpDown"       value="1"/> -->
			<!-- 0x8000:04 Gate polarity (0=active LOW, 1=active HIGH)       -->  
			<!-- <modParam name="gatePolarity"       value="0"/> -->
			<!-- 0x8000:08 Disable input filter (0=active, 1=disabled)       -->  
			<!-- <modParam name="disableFilter"      value="0"/> -->
			<!-- 0x8000:0A Enable micro increments                           -->  
			<!-- <modParam name="enableMicroInc"     value="0"/> -->
			<!-- 0x8000:0E Reversion of rotation (0=normal, 1=inverted)      -->  
			<!-- <modParam name="revRotation"        value="0"/> -->
			<!-- 0x8000:10 Extern reset polarity (0=rising edge)             -->  
			<!-- <modParam name="extResetPolarity"   value="0"/> -->
			<!-- 0x8000:11 Frequency window                                  -->  
			<!-- <modParam name="freqWindow"         value="0"/> -->
			<!-- 0x8000:13 Frequency scaling                                 -->  
			<!-- <modParam name="freqScaling"        value="0"/> -->
			<!-- 0x8000:14 Period scaling                                    -->  
			<!-- <modParam name="periodScaling"      value="0"/> -->
			<!-- 0x8000:15 Frequency resolution                              --> 
			<!-- <modParam name="freqResolution"     value="0"/> -->
			<!-- 0x8000:16 Period resolution                                 -->  
			<!-- <modParam name="periodResolution"   value="0"/> -->
			<!-- 0x8000:17 Frequency wait time                               -->  
			<!-- <modParam name="waitTime"           value="0"/> -->
		</slave>
		<slave idx="11" type="EP5101" name="EP5101-z">
			<!-- 0x8000:01 Enable C reset (index pulse resets counter)       -->  
			<modParam name="enableCReset"       value="0"/>
			<!-- 0x8000:02 Enable extern reset via external input            -->  
			<!-- <modParam name="enableExtReset"     value="0"/> -->
