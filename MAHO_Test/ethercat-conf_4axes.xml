		<slave idx="7" type="EL6224" name="EL6224">
			<!-- Port 1: Siemens device, ch1 = output, ch0+ch2-7 = inputs -->
			<modParam name="port1active"  value="true"/>
			<modParam name="port1OutMask" value="0x02"/>
			<!-- Port 2: not connected -->
			<modParam name="port2active"  value="true"/>
			<!-- Port 3: not connected -->
			<modParam name="port3active"  value="false"/>
			<!-- Port 4: not connected -->
			<modParam name="port4active"  value="false"/>
		</slave>
